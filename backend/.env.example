# Project Info
PROJECT_NAME=NexIPO
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=False

# Database
DATABASE_URL=postgresql://ipo_user:ipo_password@localhost:5432/ipo_platform
TEST_DATABASE_URL=postgresql://ipo_user:ipo_password@localhost:5432/ipo_test_db
# Max persistent connections in pool
DB_POOL_SIZE=10
# Max connections to create above pool_size
DB_MAX_OVERFLOW=20
# Seconds to wait for a connection from the pool
DB_POOL_TIMEOUT=30
# Seconds after which to recycle connections
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ipo_prospectus

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ML Service
ML_SERVICE_URL=http://localhost:8001
ML_REQUEST_TIMEOUT=30
